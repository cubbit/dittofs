#!/usr/bin/env bash
# dfs-store BUCKET [dfsctl store create flag ...]: creates a remote store on the local S3's BUCKET,
# with setup's credential and any further flags (--setting key=value, say), and prints its ID.
#   N="$(dfsctl namespace create --store "$(dfs-store x)" --setting namespace.prefix=x/ -o json | jq -r .id)"
set -euo pipefail
B="$1"
shift
dfsctl store create --setting remote.endpoint=http://127.0.0.1:9000 --setting "remote.bucket=$B" \
    --credential-file /etc/dittofs-s3.credential "$@" -o json | jq -r .id
