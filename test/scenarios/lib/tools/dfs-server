#!/usr/bin/env bash
# dfs-server start [VAR=value ...] | stop | kill: the DittoFS server.
#   start   runs it with setup's configuration and its storage key's passphrase, plus the given
#           environment (another passphrase, say), in the background. It reads the API's address
#           from the line this start logs, then signs dfsctl in as admin. The first start signs in
#           with the password dfs init printed, which must change at the first sign-in, and changes
#           it to one kept in /etc/dittofs/admin.password. It fails if dfs exits first. Its output,
#           the log among it (logging.output=stdout), goes to /logs/dfs.log.
#   stop    shuts it down cleanly (SIGTERM); kill ends it at once (SIGKILL), like a crash. Both
#           wait until it is gone.
# Resume a paused S3 before a start: startup checks the bucket.
set -euo pipefail
umask 077
LOG=/logs/dfs.log
PW=/etc/dittofs/admin.password
case "$1" in
start)
    shift
    touch "$LOG"
    FROM=$(($(wc -l <"$LOG") + 1))
    env DITTOFS_LOGGING_OUTPUT=stdout DITTOFS_LOGGING_FORMAT=text DITTOFS_ENCRYPTION_PASSPHRASE="$(cat /etc/dittofs/passphrase)" "$@" dfs start >>"$LOG" 2>&1 </dev/null &
    PID=$!
    API=
    for _ in $(seq 1 600); do
        API="$(tail -n "+$FROM" "$LOG" | sed -n 's/.*node: listening api=\([^ ]*\).*/\1/p' | head -n 1)"
        test -n "$API" && break
        kill -0 "$PID" 2>/dev/null || { echo "dfs-server: dfs exited before it listened, see $LOG" >&2 && exit 1; }
        sleep 0.1
    done
    test -n "$API" || { echo "dfs-server: dfs logged no API address in 60 s, see $LOG" >&2 && exit 1; }
    CUR="$PW"
    if ! test -s "$PW"; then
        CUR=/etc/dittofs/admin.first-password
        tail -n 1 /etc/dittofs/init.out >"$CUR"
    fi
    IN=
    for _ in $(seq 1 60); do
        dfsctl login --server "http://$API" --username admin --password-file "$CUR" >/dev/null 2>&1 && IN=1 && break
        kill -0 "$PID" 2>/dev/null || { echo "dfs-server: dfs exited before admin signed in, see $LOG" >&2 && exit 1; }
        sleep 1
    done
    test -n "$IN" || dfsctl login --server "http://$API" --username admin --password-file "$CUR"
    if test "$CUR" != "$PW"; then
        head -c 24 /dev/urandom | base64 >"$PW.new"
        dfsctl password change --current-password-file "$CUR" --new-password-file "$PW.new"
        mv "$PW.new" "$PW"
    fi
    ;;
stop | kill)
    if test "$1" = kill; then pkill -KILL -x dfs || true; else pkill -TERM -x dfs || true; fi
    while pgrep -x dfs >/dev/null; do sleep 0.2; done
    ;;
*) echo "usage: dfs-server start [VAR=value ...] | stop | kill" >&2 && exit 2 ;;
esac
