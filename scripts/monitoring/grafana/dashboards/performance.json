{
  "uid": "dittofs-performance",
  "title": "Performance",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "dittofs",
    "performance"
  ],
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "nic",
        "label": "nic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_network_info{device!~\"lo|veth.*|docker.*|br-.*|dfsmon0|virbr.*|cni.*|cali.*|flannel.*\"}, device)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(node_network_info{device!~\"lo|veth.*|docker.*|br-.*|dfsmon0|virbr.*|cni.*|cali.*|flannel.*\"}, device)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "disk",
        "label": "disk",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_disk_info{device!~\"loop.*|ram.*|zram.*|sr.*|dm-.*|md.*\"}, device)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(node_disk_info{device!~\"loop.*|ram.*|zram.*|sr.*|dm-.*|md.*\"}, device)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Aggregate CPU utilisation across all cores (100% = every core busy).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{__auto}}",
          "interval": "5s",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "CPU usage by mode",
      "description": "CPU time split by mode (user, system, iowait, irq, softirq, steal, ...). Stacked so iowait is clearly visible during storage-bound benchmark runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * avg by (mode) (rate(node_cpu_seconds_total{instance=\"$instance\",mode!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}",
          "interval": "5s",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "CPU iowait %",
      "description": "Share of CPU time waiting on I/O. A sustained rise during a run usually means the storage device is the bottleneck; useful for eyeballing bench runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * avg(rate(node_cpu_seconds_total{instance=\"$instance\",mode=\"iowait\"}[$__rate_interval]))",
          "legendFormat": "{{__auto}}",
          "interval": "5s",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Storage device util %",
      "description": "Percentage of wall-clock time each disk spent servicing I/O (dm-*/md* device-mapper and raid devices excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * rate(node_disk_io_time_seconds_total{instance=\"$instance\",device=~\"$disk\",device!~\"dm-.*|md.*\"}[$__rate_interval])",
          "legendFormat": "{{device}}",
          "interval": "5s",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Throughput read from and written to each disk (B/s), plus the weighted I/O time, which approximates the average queue depth.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* queue depth"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_disk_read_bytes_total{instance=\"$instance\",device=~\"$disk\",device!~\"dm-.*|md.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} read",
          "interval": "5s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_disk_written_bytes_total{instance=\"$instance\",device=~\"$disk\",device!~\"dm-.*|md.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} write",
          "interval": "5s",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_disk_io_time_weighted_seconds_total{instance=\"$instance\",device=~\"$disk\",device!~\"dm-.*|md.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} queue depth",
          "interval": "5s",
          "range": true,
          "refId": "C"
        }
      ],
      "id": 5
    },
    {
      "type": "gauge",
      "title": "Used RAM",
      "description": "Fraction of total RAM in use (total minus available). Yellow above 70%, red above 90%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(node_memory_MemTotal_bytes{instance=\"$instance\"} - node_memory_MemAvailable_bytes{instance=\"$instance\"}) / node_memory_MemTotal_bytes{instance=\"$instance\"}",
          "legendFormat": "used",
          "interval": "5s",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Swap",
      "description": "Swap space total, free and used, in bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_memory_SwapTotal_bytes{instance=\"$instance\"}",
          "legendFormat": "total",
          "interval": "5s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_memory_SwapFree_bytes{instance=\"$instance\"}",
          "legendFormat": "free",
          "interval": "5s",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_memory_SwapTotal_bytes{instance=\"$instance\"} - node_memory_SwapFree_bytes{instance=\"$instance\"}",
          "legendFormat": "used",
          "interval": "5s",
          "range": true,
          "refId": "C"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Swap in/out",
      "description": "bytes/s of data moving in and out of swap; assumes 4 KiB pages (x16 needed on 64 KiB-page arm64 kernels).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_vmstat_pswpin{instance=\"$instance\"}[$__rate_interval]) * 4096",
          "legendFormat": "swap in",
          "interval": "5s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_vmstat_pswpout{instance=\"$instance\"}[$__rate_interval]) * 4096",
          "legendFormat": "swap out",
          "interval": "5s",
          "range": true,
          "refId": "B"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Network bandwidth",
      "description": "Bits per second received and transmitted on the selected interfaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_network_receive_bytes_total{instance=\"$instance\",device=~\"$nic\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} rx",
          "interval": "5s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_network_transmit_bytes_total{instance=\"$instance\",device=~\"$nic\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} tx",
          "interval": "5s",
          "range": true,
          "refId": "B"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Network packets",
      "description": "Packets per second received and transmitted on the selected interfaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_network_receive_packets_total{instance=\"$instance\",device=~\"$nic\"}[$__rate_interval])",
          "legendFormat": "{{device}} rx packets",
          "interval": "5s",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(node_network_transmit_packets_total{instance=\"$instance\",device=~\"$nic\"}[$__rate_interval])",
          "legendFormat": "{{device}} tx packets",
          "interval": "5s",
          "range": true,
          "refId": "B"
        }
      ],
      "id": 10
    }
  ]
}
