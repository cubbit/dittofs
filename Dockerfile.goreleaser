# Dockerfile.goreleaser - Simplified Dockerfile for GoReleaser
# GoReleaser builds the binary separately and copies it into this image

FROM alpine:3.21

# OCI Image Labels (GoReleaser adds version/revision labels at build time)
LABEL org.opencontainers.image.title="DittoFS" \
      org.opencontainers.image.description="Modular virtual filesystem with pluggable storage backends" \
      org.opencontainers.image.url="https://github.com/cubbit/dittofs" \
      org.opencontainers.image.source="https://github.com/cubbit/dittofs" \
      org.opencontainers.image.vendor="Marco Moschettini" \
      org.opencontainers.image.licenses="MIT"

# Install ca-certificates for HTTPS (S3, etc.) and create non-root user
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 65532 -S dittofs && \
    adduser -u 65532 -S -G dittofs -h /app dittofs

WORKDIR /app

# Copy the pre-built binary from GoReleaser (dockers_v2 organizes by platform)
ARG TARGETPLATFORM=linux/amd64
COPY ${TARGETPLATFORM}/dfs /app/dfs

# Create data directories with proper permissions
RUN mkdir -p /data/metadata /data/blocks/journal /data/cache /data/state /config && \
    chown -R 65532:65532 /app /data /config

# Run as non-root user
USER 65532:65532

# Expose ports:
# - 12049: NFS server (default)
# - 12445: SMB server (default)
# - 8080: REST API (health checks, management)
# - 9090: Prometheus metrics endpoint. On by default but bound to loopback
#         (metrics.listen = 127.0.0.1:9090), so publishing this port alone
#         exposes nothing: set metrics.listen to 0.0.0.0:9090 (which needs
#         api.tls.cert_file and key_file) for it to be reachable from outside
#         the container.
# - 5353/udp: mDNS / DNS-SD network discovery (macOS Finder, Linux Avahi)
# - 3702/udp: WS-Discovery (Windows Explorer Network)
# - 5357/tcp: WS-Discovery device metadata (HTTP)
# Note: multicast discovery (5353/3702) only works on the host LAN / hostNetwork;
# it does not traverse standard container/K8s overlay networks.
EXPOSE 12049/tcp 12445/tcp 8080/tcp 9090/tcp 5353/udp 3702/udp 5357/tcp

# Volume mounts:
# - /data/metadata: Metadata store (BadgerDB, etc.)
# - /data/blocks: Journal root (the only copy of bytes not yet offloaded)
# - /data/state: the state directory (XDG_STATE_HOME below points at it).
# - /data/cache: not read by default. Nothing in the image's configuration
#   points at it, so it holds data only if the config names a path inside it.
# - /config: Configuration file location
VOLUME ["/data/metadata", "/data/blocks", "/data/cache", "/data/state", "/config"]

# Health check on the API's liveness probe. The API is served over TLS on
# every address but loopback, and the certificate names the host rather than
# localhost, so it is not verified.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider --no-check-certificate https://localhost:8080/health/live || exit 1

# The state directory resolves under $STATE_DIRECTORY, else $XDG_STATE_HOME/dittofs,
# else $HOME/.local/state/dittofs; $HOME is /app, so point it at the volume.
ENV XDG_STATE_HOME=/data/state

ENTRYPOINT ["/app/dfs"]
CMD ["start", "--config", "/config/config.yaml"]
