# An AUTH_SYS credential's body of 16 groups, RFC 5531 Appendix A's most: uid 1000, gid 1000, groups 1 to 16.
00000000  # stamp
00000000  # machine name: no bytes
000003e8  # uid 1000
000003e8  # gid 1000
00000010  # sixteen groups
00000001 00000002 00000003 00000004
00000005 00000006 00000007 00000008
00000009 0000000a 0000000b 0000000c
0000000d 0000000e 0000000f 00000010
