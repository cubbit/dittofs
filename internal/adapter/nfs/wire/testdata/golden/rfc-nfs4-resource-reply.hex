# Its reply: NFS4ERR_RESOURCE, NFSv4.0 having no NFS4ERR_TOO_MANY_OPS (RFC 7530 section 13).
0000002c  # xid
00000001  # REPLY
00000000  # MSG_ACCEPTED
00000000 00000000  # verifier: AUTH_NONE, no body
00000000  # SUCCESS
00002722  # NFS4ERR_RESOURCE
00000005 61626364 65000000  # the tag
00000000  # no results
