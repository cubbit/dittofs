# Its reply while no row serves READ: NFS4ERR_NOTSUPP at it (RFC 21 section 11.5).
0000002e  # xid
00000001  # REPLY
00000000  # MSG_ACCEPTED
00000000 00000000  # verifier: AUTH_NONE, no body
00000000  # SUCCESS
00002714  # NFS4ERR_NOTSUPP
00000005 61626364 65000000  # the tag
00000001  # one result
00000019 00002714  # OP_READ, NFS4ERR_NOTSUPP
