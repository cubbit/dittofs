# A NULL call to MOUNT version 3 under AUTH_SYS of one group, written from RFC 5531 sections 9
# and 11 and Appendix A: no byte example exists for it.
80000044  # record mark: last fragment, 68 bytes
11223344  # xid
00000000  # CALL
00000002  # RPC version 2
000186a5  # program MOUNT
00000003  # version 3
00000000  # procedure NULL
00000001 0000001c  # credential: AUTH_SYS, 28 bytes
  00000000  # stamp
  00000004 686f7374  # machine name "host", 4 bytes, no padding
  000003e8  # uid 1000
  00000064  # gid 100
  00000001 0000001b  # one auxiliary group, 27
00000000 00000000  # verifier: AUTH_NULL, no body
