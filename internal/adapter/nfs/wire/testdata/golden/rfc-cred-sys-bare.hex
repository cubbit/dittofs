# An AUTH_SYS credential's body, an authsys_parms (RFC 5531 Appendix A): stamp 0, no machine name, uid 1000, gid 1000, groups 10, 20 and 30.
00000000  # stamp
00000000  # machine name: no bytes
000003e8  # uid 1000
000003e8  # gid 1000
00000003  # three groups
0000000a 00000014 0000001e  # 10, 20, 30
