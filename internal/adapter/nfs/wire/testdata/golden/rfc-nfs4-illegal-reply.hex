# Its reply: NFS4ERR_OP_ILLEGAL, the tag echoed, one result, ILLEGAL's (RFC 8881 section 15).
00000029  # xid
00000001  # REPLY
00000000  # MSG_ACCEPTED
00000000 00000000  # verifier: AUTH_NONE, no body
00000000  # SUCCESS
0000273c  # NFS4ERR_OP_ILLEGAL
00000005 61626364 65000000  # the tag
00000001  # one result
0000273c 0000273c  # OP_ILLEGAL, NFS4ERR_OP_ILLEGAL
