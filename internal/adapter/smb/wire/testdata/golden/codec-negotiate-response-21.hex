# The body of an SMB2 NEGOTIATE response (MS-SMB2 2.2.4) at dialect 2.1,
# written by hand from frame 6 of test/pcap-corpus/smb-sd/reference.pcap
# (codec-negotiate-response.hex): before 3.1.1, NegotiateContextCount and
# NegotiateContextOffset are Reserved and Reserved2, 0, and no padding or
# negotiate context follows the security buffer. Positions count from the SMB2
# header's first byte, as the offsets do. Multi-byte fields are little-endian
# (MS-SMB2 2.2).
41 00                       # [64,66)   StructureSize 65
01 00                       # [66,68)   SecurityMode 1: SIGNING_ENABLED
10 02                       # [68,70)   DialectRevision 0x0210
00 00                       # [70,72)   Reserved
64 69 74 74 6f 66 73 2d     # [72,88)   ServerGuid
73 6d 62 73 64 00 00 00
0f 00 00 00                 # [88,92)   Capabilities 0x0F
00 00 80 00                 # [92,96)   MaxTransactSize 8 MiB
00 00 80 00                 # [96,100)  MaxReadSize 8 MiB
00 00 80 00                 # [100,104) MaxWriteSize 8 MiB
f2 f5 aa 4a c4 01 dd 01     # [104,112) SystemTime
00 00 00 00 00 00 00 00     # [112,120) ServerStartTime 0
80 00                       # [120,122) SecurityBufferOffset 128
4a 00                       # [122,124) SecurityBufferLength 74
00 00 00 00                 # [124,128) Reserved2
60 48 06 06 2b 06 01 05     # [128,202) Buffer: the security buffer, frame 6's
05 02 a0 3e 30 3c a0 0e
30 0c 06 0a 2b 06 01 04
01 82 37 02 02 0a a3 2a
30 28 a0 26 1b 24 6e 6f
74 5f 64 65 66 69 6e 65
64 5f 69 6e 5f 52 46 43
34 31 37 38 40 70 6c 65
61 73 65 5f 69 67 6e 6f
72 65
