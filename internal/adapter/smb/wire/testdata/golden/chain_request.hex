# Two hand-written SMB2 requests chained in one message (MS-SMB2 2.2.1.2): a
# CREATE, then a related CLOSE that takes its session and tree from it, as
# MS-SMB2 3.2.4.1.4 has a client send one. The CREATE's NextCommand steps
# over its 12 bytes of arguments and 4 bytes of padding to the CLOSE's
# 8-byte aligned header. The arguments are not real ones: this package does
# not read them. Multi-byte fields are little-endian (MS-SMB2 2.2).
fe 53 4d 42                 # [0,4)    ProtocolId 0xFE 'S' 'M' 'B'
40 00                       # [4,6)    StructureSize 64
01 00                       # [6,8)    CreditCharge 1
00 00 00 00                 # [8,12)   ChannelSequence 0, Reserved 0
05 00                       # [12,14)  Command 0x0005, CREATE
02 00                       # [14,16)  CreditRequest 2
00 00 00 00                 # [16,20)  Flags: none
50 00 00 00                 # [20,24)  NextCommand 80: the CLOSE's header
0a 00 00 00 00 00 00 00     # [24,32)  MessageId 10
00 00 00 00                 # [32,36)  Reserved
05 00 00 00                 # [36,40)  TreeId 5
07 00 00 00 00 00 00 00     # [40,48)  SessionId 7
00 00 00 00 00 00 00 00     # [48,64)  Signature: not signed
00 00 00 00 00 00 00 00
01 02 03 04 05 06 07 08     # [64,76)  the CREATE's arguments
09 0a 0b 0c
00 00 00 00                 # [76,80)  padding to 8
fe 53 4d 42                 # [80,84)  ProtocolId 0xFE 'S' 'M' 'B'
40 00                       # [84,86)  StructureSize 64
01 00                       # [86,88)  CreditCharge 1
00 00 00 00                 # [88,92)  ChannelSequence 0, Reserved 0
06 00                       # [92,94)  Command 0x0006, CLOSE
01 00                       # [94,96)  CreditRequest 1
04 00 00 00                 # [96,100) Flags 0x00000004, RELATED_OPERATIONS
00 00 00 00                 # [100,104) NextCommand 0: the last member
0b 00 00 00 00 00 00 00     # [104,112) MessageId 11
00 00 00 00                 # [112,116) Reserved
ff ff ff ff                 # [116,120) TreeId 0xFFFFFFFF: a related member's placeholder (MS-SMB2 3.2.4.1.4)
ff ff ff ff ff ff ff ff     # [120,128) SessionId 0xFFFFFFFFFFFFFFFF: a related member's placeholder (MS-SMB2 3.2.4.1.4)
00 00 00 00 00 00 00 00     # [128,144) Signature: not signed
00 00 00 00 00 00 00 00
18 00 00 00                 # [144,148) the CLOSE's arguments
