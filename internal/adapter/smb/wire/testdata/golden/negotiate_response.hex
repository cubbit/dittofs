# test/pcap-corpus/smb-sd/reference.pcap, frame 6: the reference server's
# SMB2 NEGOTIATE response to frame 4, the frame's TCP payload as tshark cuts
# it (tcp.payload). The Direct TCP header (MS-SMB2 2.1), the SMB2 header in
# its sync form (MS-SMB2 2.2.1.2), field by field, then the NEGOTIATE
# response's body, which this package does not read. Multi-byte header fields
# are little-endian (MS-SMB2 2.2).
00                          # Direct TCP header: Zero
00 01 1c                    # StreamProtocolLength 284, big-endian
fe 53 4d 42                 # [0,4)   ProtocolId 0xFE 'S' 'M' 'B'
40 00                       # [4,6)   StructureSize 64
00 00                       # [6,8)   CreditCharge 0, the request's
00 00 00 00                 # [8,12)  Status 0, STATUS_SUCCESS
00 00                       # [12,14) Command 0x0000, NEGOTIATE
01 00                       # [14,16) CreditResponse 1
01 00 00 00                 # [16,20) Flags: SERVER_TO_REDIR
00 00 00 00                 # [20,24) NextCommand 0
00 00 00 00 00 00 00 00     # [24,32) MessageId 0, the request's
00 00 00 00                 # [32,36) Reserved
00 00 00 00                 # [36,40) TreeId 0
00 00 00 00 00 00 00 00     # [40,48) SessionId 0
00 00 00 00 00 00 00 00     # [48,64) Signature: none
00 00 00 00 00 00 00 00
# [64,284) the NEGOTIATE response's body
41 00 01 00 11 03 03 00 64 69 74 74 6f 66 73 2d
73 6d 62 73 64 00 00 00 0f 00 00 00 00 00 80 00
00 00 80 00 00 00 80 00 f2 f5 aa 4a c4 01 dd 01
00 00 00 00 00 00 00 00 80 00 4a 00 d0 00 00 00
60 48 06 06 2b 06 01 05 05 02 a0 3e 30 3c a0 0e
30 0c 06 0a 2b 06 01 04 01 82 37 02 02 0a a3 2a
30 28 a0 26 1b 24 6e 6f 74 5f 64 65 66 69 6e 65
64 5f 69 6e 5f 52 46 43 34 31 37 38 40 70 6c 65
61 73 65 5f 69 67 6e 6f 72 65 00 00 00 00 00 00
01 00 26 00 00 00 00 00 01 00 20 00 01 00 5c ae
73 0b 27 fe 5d ef 94 4d f7 35 0f 70 67 07 93 fe
62 cc a8 3b ee 7b e8 70 d9 35 88 b7 32 05 00 00
