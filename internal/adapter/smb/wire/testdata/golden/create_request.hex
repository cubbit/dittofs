# test/pcap-corpus/smb-sd/reference.pcap, frame 126: a client's SMB2 CREATE
# request for file.txt to the reference server, the frame's TCP payload as
# tshark cuts it (tcp.payload). The Direct TCP header (MS-SMB2 2.1), the SMB2
# header in its sync form (MS-SMB2 2.2.1.2), field by field, then the CREATE
# request's body, which this package does not read. Multi-byte header fields
# are little-endian (MS-SMB2 2.2).
00                          # Direct TCP header: Zero
00 00 88                    # StreamProtocolLength 136, big-endian
fe 53 4d 42                 # [0,4)   ProtocolId 0xFE 'S' 'M' 'B'
40 00                       # [4,6)   StructureSize 64
01 00                       # [6,8)   CreditCharge 1
00 00 00 00                 # [8,12)  ChannelSequence 0, Reserved 0
05 00                       # [12,14) Command 0x0005, CREATE
01 00                       # [14,16) CreditRequest 1
10 00 00 00                 # [16,20) Flags 0x00000010: PRIORITY_MASK, priority 1
00 00 00 00                 # [20,24) NextCommand 0: no member follows
0e 00 00 00 00 00 00 00     # [24,32) MessageId 14
00 00 00 00                 # [32,36) Reserved
b3 b3 88 09                 # [36,40) TreeId 0x0988b3b3
dc 65 d9 a6 00 00 00 00     # [40,48) SessionId 0xa6d965dc
00 00 00 00 00 00 00 00     # [48,64) Signature: not signed
00 00 00 00 00 00 00 00
# [64,136) the CREATE request's body
39 00 00 00 02 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 0c 00 00 00 00 00
03 00 00 00 01 00 00 00 00 00 00 00 78 00 10 00
00 00 00 00 00 00 00 00 66 00 69 00 6c 00 65 00
2e 00 74 00 78 00 74 00
