#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook for DittoFS. Runs the `unit` suite, narrowed to the packages
# the branch changed, plus `operator` when its module changed, so CI doesn't
# burn time on a trivially-broken branch. dt runs the suite exactly as
# test/suites.yaml defines it, the way CI does (CLAUDE.md, "By kind").
# --changed widens to every package when a changed file sits in no package
# (a script, a doc: any test may read it), more than a push wants to wait for,
# so the hook picks the changed Go packages itself and passes --packages.
#
# Skip entirely: git push --no-verify, or DITTOFS_SKIP_PREPUSH=1.

if [ -n "${DITTOFS_SKIP_PREPUSH:-}" ]; then
    exit 0
fi

# $1 = remote name, $2 = remote URL. Stdin: "<local-ref> <local-sha> <remote-ref> <remote-sha>"
# We don't need per-ref granularity — use the working tree against origin/develop.
BASE_REF="${DITTOFS_PREPUSH_BASE:-origin/develop}"
if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
    echo "pre-push: $BASE_REF not found, skipping test selection" >&2
    exit 0
fi

CHANGED_GO=$(git diff --name-only "$BASE_REF"...HEAD -- '*.go' 2>/dev/null || true)
[ -n "$CHANGED_GO" ] || exit 0

# Map changed files → unique package dirs. A directory named testdata, or
# starting with _ or ., is dropped: go never builds one, and its fixtures
# are not meant to compile.
PKGS=$(echo "$CHANGED_GO" | xargs -n1 dirname | grep -Ev '(^|/)(testdata|[._][^/]+)(/|$)' | sort -u | sed 's|^|./|' || true)
[ -n "$PKGS" ] || exit 0

# The operator is a separate Go module and suite; it runs whole whenever its
# own tree changed (RFC 29: --packages narrows only a cell that takes
# {packages}, and the operator's cells don't).
OPERATOR_DIR="k8s/dittofs-operator"
ROOT_PKGS=""
while IFS= read -r pkg; do
    case "$pkg" in
        "./$OPERATOR_DIR"*) ;;
        *) ROOT_PKGS+=" $pkg" ;;
    esac
done <<< "$PKGS"

# Git exports GIT_DIR and its siblings to a hook; a test that runs git in a
# repository of its own would otherwise commit into this one. dt passes the
# environment through, so this still guards it (as it did #3922's go test).
# shellcheck disable=SC2046  # one variable name per word
unset $(git rev-parse --local-env-vars)

run_suite() {
    # --packages takes one comma-separated value; several words would read as
    # the suite's TEST patterns and the run would refuse them.
    # shellcheck disable=SC2086  # intentional word-splitting
    local pkgs
    pkgs=$(printf '%s\n' $2 | paste -sd, -)
    if ! test/harness/bin/dt run "$1" --packages "$pkgs"; then
        echo "" >&2
        echo "pre-push: $1 failed. 'git push --no-verify' skips." >&2
        exit 1
    fi
}

[ -z "$ROOT_PKGS" ] || run_suite unit "$ROOT_PKGS"
# The operator runs whenever its own tree changed; --packages narrows nothing
# there, so its full make test and lint run, as they always did.
if printf '%s\n' "$CHANGED_GO" | grep -q "^$OPERATOR_DIR/"; then
    if ! test/harness/bin/dt run operator; then
        echo "" >&2
        echo "pre-push: operator failed. 'git push --no-verify' skips." >&2
        exit 1
    fi
fi
